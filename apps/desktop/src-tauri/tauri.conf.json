{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lemon Tree",
  "version": "0.1.0",
  "identifier": "com.lemontree.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lemon Tree",
        "width": 1440,
        "height": 900,
        "minWidth": 1120,
        "minHeight": 700
      }
    ],
    "security": { "csp": null }
  },
  "plugins": { "sql": { "preload": ["sqlite:lemon-tree.db"] } },
  "bundle": { "active": true, "targets": "all" }
}
